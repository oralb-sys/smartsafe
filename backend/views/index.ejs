<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>SmartSafe - Reportar evento</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">

</head>


<body class="bg-light">


<div class="container py-3 py-md-5">

    <div class="row justify-content-center">

        <div class="col-12 col-md-8 col-lg-6">

            <div class="card shadow-sm border-0">

                <!-- CABECERA -->

                <div class="card-body p-4">

                    <div class="text-center mb-4">

                        <h2 class="fw-bold text-primary">
                            SmartSafe
                        </h2>

                        <p class="text-muted mb-0">
                            Reporte de eventos
                        </p>

                    </div>


                    <form id="eventForm" action="<%= BASE_URL %>/" method="POST" enctype="multipart/form-data">

                        <!-- USUARIO -->

                        <div class="mb-3">

                            <label
                                for="usuario"
                                class="form-label fw-semibold">

                                Usuario

                            </label>

                            <input
                                type="text"
                                class="form-control form-control-lg"
                                id="usuario"
                                name="usuario"
                                placeholder="DNI"
                                required>

                        </div>


                        <!-- FOTO -->

                        <div class="mb-3">

                            <label
                                for="foto"
                                class="form-label fw-semibold">

                                Fotografía del evento

                            </label>

                            <input
                                type="file"
                                class="form-control form-control-lg"
                                id="foto"
                                name="foto"
                                accept="image/*"
                                capture="environment"
                                required>

                            <div class="form-text">

                                Puede tomar una fotografía
                                directamente con su celular.

                            </div>


                        </div>


                        <!-- PREVISUALIZACIÓN -->

                        <div
                            id="previewContainer"
                            class="mb-3 text-center d-none">

                            <img
                                id="preview"
                                class="img-fluid rounded"
                                style="max-height: 300px;"
                                alt="Vista previa">

                        </div>


                        <!-- TIPO DE EVENTO -->

                        <div class="mb-3">

                            <label
                                for="tipo"
                                class="form-label fw-semibold">

                                Tipo de evento

                            </label>

                            <select
                                class="form-select form-select-lg"
                                id="tipo"
                                name="tipo"
                                required>

                                <option value="">
                                    Seleccione un evento
                                </option>

                                <option value="accidente">
                                    Accidente
                                </option>

                                <option value="incendio">
                                    Incendio
                                </option>

                                <option value="robo">
                                    Robo
                                </option>

                                <option value="emergencia_medica">
                                    Emergencia médica
                                </option>

                                <option value="persona_sospechosa">
                                    Persona sospechosa
                                </option>

                                <option value="otro">
                                    Otro
                                </option>

                            </select>

                        </div>


                        <!-- DESCRIPCIÓN -->

                        <div class="mb-3">

                            <div
                                class="d-flex justify-content-between">

                                <label
                                    for="descripcion"
                                    class="form-label fw-semibold">

                                    Descripción

                                </label>

                                <small
                                    id="contador"
                                    class="text-muted">

                                    0 / 30 palabras

                                </small>

                            </div>


                            <textarea
                                class="form-control"
                                id="descripcion"
                                name="descripcion"
                                rows="5"
                                placeholder="Describa brevemente el evento que está observando..."
                                required></textarea>

                        </div>

                        <!-- COORDENADAS GPS -->

                        <input
                            type="hidden"
                            id="latitud"
                            name="latitud">

                        <input
                            type="hidden"
                            id="longitud"
                            name="longitud">


                        <div class="mb-3">

                            <div
                                id="estadoGPS"
                                class="alert alert-warning mb-0">

                                Obteniendo ubicación...

                            </div>

                        </div>

                        <!-- BOTÓN -->

                        <div class="d-grid mt-4">

                            <button
                                type="submit"
                                class="btn btn-primary btn-lg">

                                Reportar evento

                            </button>

                        </div>

                    </form>

                </div>

            </div>


            <!-- PIE -->

            <p class="text-center text-muted small mt-3">

                SmartSafe © 2026

            </p>

        </div>

    </div>

</div>


<script>

    // ============================
    // PREVISUALIZACIÓN DE FOTO
    // ============================

    const foto =
        document.getElementById('foto');

    const preview =
        document.getElementById('preview');

    const previewContainer =
        document.getElementById('previewContainer');


    foto.addEventListener('change', function () {

        const archivo = this.files[0];

        if (!archivo) {
            return;
        }

        const reader = new FileReader();

        reader.onload = function (e) {

            preview.src = e.target.result;

            previewContainer.classList.remove('d-none');

        };

        reader.readAsDataURL(archivo);

    });


    // ============================
    // CONTADOR DE PALABRAS
    // ============================

    const descripcion =
        document.getElementById('descripcion');

    const contador =
        document.getElementById('contador');


    descripcion.addEventListener('input', function () {

        let palabras =
            this.value.trim() === ''
                ? []
                : this.value.trim().split(/\s+/);


        if (palabras.length > 30) {

            palabras =
                palabras.slice(0, 30);

            this.value =
                palabras.join(' ');

        }


        contador.textContent =
            palabras.length + ' / 30 palabras';

    });


// ========================================
// OBTENER UBICACIÓN GPS
// ========================================

const latitud =
    document.getElementById('latitud');

const longitud =
    document.getElementById('longitud');

const estadoGPS =
    document.getElementById('estadoGPS');


function obtenerUbicacion() {

    if (!navigator.geolocation) {

        estadoGPS.className =
            'alert alert-danger mb-0';

        estadoGPS.textContent =
            'Este dispositivo no permite obtener ubicación.';

        return;

    }


    estadoGPS.className =
        'alert alert-warning mb-0';

    estadoGPS.textContent =
        'Obteniendo ubicación...';


    navigator.geolocation.getCurrentPosition(

        function (position) {

            latitud.value =
                position.coords.latitude;

            longitud.value =
                position.coords.longitude;


            estadoGPS.className =
                'alert alert-success mb-0';

            estadoGPS.textContent =
                '✓ Ubicación obtenida correctamente';


            console.log(
                'Latitud:',
                position.coords.latitude
            );


            console.log(
                'Longitud:',
                position.coords.longitude
            );

        },


        function (error) {

            console.error(
                'Error al obtener ubicación:',
                error
            );


            estadoGPS.className =
                'alert alert-danger mb-0';


            estadoGPS.textContent =
                'No se pudo obtener la ubicación. ' +
                'Debe permitir el acceso al GPS.';

        },


        {
            enableHighAccuracy: true,
            timeout: 10000,
            maximumAge: 0
        }

    );

}


obtenerUbicacion();
</script>

</body>

</html>